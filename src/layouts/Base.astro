---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'Analize argumentate, bazate pe date statistice reale și surse verificabile.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Radar Active</title>
  </head>
  <body>
    <header class="site">
      <div class="container">
        <a class="brand" href={base}>Radar Active</a>
        <nav>
          <a href={base}>Domenii</a>
          <a href={`${base}metodologie/`}>Metodologie</a>
        </nav>
      </div>
    </header>
    <main class="container"><slot /></main>
    <footer class="site">
      <div class="container">Fiecare cifră de pe site are sursă, link și dată de preluare. Analizele nu sunt recomandări de investiții.</div>
    </footer>
  </body>
</html>
