---
import '../styles/global.css';
interface Props { title: string; description?: string; image?: string; lang?: 'ro' | 'en'; alt?: string; noindex?: boolean }
const { title, description: desc0,  image = 'images/crypto-1600.jpg', lang = 'ro', alt, noindex = false } = Astro.props;
const en = lang === 'en';
const description = desc0 ?? (en ? 'Reasoned analyses based on real statistical data and verifiable sources.' : 'Analize argumentate, bazate pe date statistice reale și surse verificabile.');
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const site = Astro.site ? new URL(base, Astro.site).href : base;
const canonical = Astro.site ? new URL(path, Astro.site).href : path;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title} · {en ? 'Explosive Assets Radar' : 'Radar Active Explozive'}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={en ? 'Explosive Assets Radar' : 'Radar Active Explozive'} />
    <meta property="og:title" content={`${title} · ${en ? 'Explosive Assets Radar' : 'Radar Active Explozive'}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}${image}`} />
    <meta property="og:locale" content={en ? 'en_GB' : 'ro_RO'} />
    {alt !== undefined && <link rel="alternate" hreflang={en ? 'ro' : 'en'} href={Astro.site ? new URL(base + alt, Astro.site).href : base + alt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={`${base}sitemap.xml`} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%230f1d2e'/%3E%3Ccircle cx='16' cy='16' r='9' fill='none' stroke='%236f8dff' stroke-width='1.5'/%3E%3Ccircle cx='16' cy='16' r='4' fill='none' stroke='%236f8dff' stroke-width='1.5'/%3E%3Cpath d='M16 16 L27 9' stroke='%236f8dff' stroke-width='2'/%3E%3Ccircle cx='21' cy='12' r='2' fill='%2345c48a'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <header class="site">
      <div class="container">
        <a class="brand" href={en ? `${base}en/` : base}>
          <svg width="24" height="24" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="14" fill="var(--scope)" /><circle cx="16" cy="16" r="9" fill="none" stroke="#6f8dff" stroke-width="1.5" /><circle cx="16" cy="16" r="4" fill="none" stroke="#6f8dff" stroke-width="1.5" /><path d="M16 16 L27 9" stroke="#6f8dff" stroke-width="2" /><circle cx="21" cy="12" r="2" fill="#45c48a" /></svg>
          {en ? 'Explosive Assets Radar' : 'Radar Active Explozive'}
        </a>
        <nav aria-label={en ? "Main navigation" : "Navigare principală"}>
          {en ? (
            <>
              <a href={`${base}en/`} aria-current={path === `${base}en/` ? 'page' : undefined}>Home</a>
              <a href={`${base}en/investments/`} aria-current={path.startsWith(`${base}en/investments/`) ? 'page' : undefined}>Investments</a>
              <a href={`${base}en/macro/`} aria-current={path.startsWith(`${base}en/macro/`) ? 'page' : undefined}>Macroeconomics</a>
              <a href={`${base}en/social/`} aria-current={path.startsWith(`${base}en/social/`) ? 'page' : undefined}>Social</a>
              <a href={`${base}en/substance/`} aria-current={path.startsWith(`${base}en/substance/`) ? 'page' : undefined}>Substance, not form</a>
              <a href={`${base}en/methodology/`} aria-current={path.startsWith(`${base}en/methodology/`) ? 'page' : undefined}>Methodology</a>
            </>
          ) : (
            <>
              <a href={base} aria-current={path === base ? 'page' : undefined}>Acasă</a>
              <a href={`${base}investitii/`} aria-current={path.startsWith(`${base}investitii/`) ? 'page' : undefined}>Investiții</a>
              <a href={`${base}macro/`} aria-current={path.startsWith(`${base}macro/`) ? 'page' : undefined}>Macroeconomie</a>
              <a href={`${base}social/`} aria-current={path.startsWith(`${base}social/`) ? 'page' : undefined}>Social</a>
              <a href={`${base}fond/`} aria-current={path.startsWith(`${base}fond/`) ? 'page' : undefined}>Fond, nu formă</a>
              <a href={`${base}metodologie/`} aria-current={path.startsWith(`${base}metodologie/`) ? 'page' : undefined}>Metodologie</a>
            </>
          )}
          <a class="lang" href={en ? (alt ? base + alt : base) : `${base}${alt ?? 'en/'}`} hreflang={en ? 'ro' : 'en'} lang={en ? 'ro' : 'en'}>{en ? 'RO' : 'EN'}</a>
        </nav>
      </div>
    </header>
    <main class="container"><slot /></main>
    <footer class="site">
      <div class="container">{en
        ? <>Every figure on the site has a source, a link and a retrieval date. The analyses are not investment advice. The radar stays free: <a href={`${base}en/funding/`}>how we are funded</a>. <a href={`${base}en/services/`}>For companies</a> · <a href={`${base}en/partners/`}>Become a partner</a> · <a href={`${base}en/account/`}>Your account</a> · <a href={`${base}en/privacy/`}>Privacy</a></>
        : <>Fiecare cifră de pe site are sursă, link și dată de preluare. Analizele nu sunt recomandări de investiții. Radarul rămâne gratuit: <a href={`${base}finantare/`}>cum ne finanțăm</a>. <a href={`${base}servicii/`}>Pentru companii</a> · <a href={`${base}parteneri/`}>Devino partener</a> · <a href={`${base}cont/`}>Contul tău</a> · <a href={`${base}confidentialitate/`}>Confidențialitate</a></>}</div>
    </footer>
  </body>
</html>
