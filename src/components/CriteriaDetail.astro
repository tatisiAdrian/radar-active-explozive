---
import { CRITERIA } from '../data/criteria';
import { explain } from '../data/explain';

interface Props {
  /** cheia setului de condiții: general, marfuri, forex, economii-emergente, sp500 */
  set: string;
  values: (number | null | undefined)[];
  /** cifrele din spatele notelor calculate, pe chei C1..C14 */
  inputs?: Record<string, string>;
}
const { set, values, inputs = {} } = Astro.props;
const crit = CRITERIA[set];
const cls = (v: number | null | undefined) => (v == null ? 'slab' : v >= 7 ? 'puternic' : v >= 5 ? 'observatie' : 'slab');
---
<div class="table-wrap">
  <table class="radar criteria explain">
    <thead><tr><th>#</th><th>Condiție</th><th>Notă</th><th>Pe înțeles</th></tr></thead>
    <tbody>
      {crit.map(([name], i) => {
        const k = `C${i + 1}`;
        const v = values[i];
        return (
          <tr>
            <td class="muted">{k}</td>
            <td><b>{name}</b></td>
            <td><span class:list={['k', cls(v)]}>{v ?? '—'}</span></td>
            <td>
              {explain(set, i, v)}
              {inputs[k] && <><br /><small class="muted">Date: {inputs[k]}</small></>}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
