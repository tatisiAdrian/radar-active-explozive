---
import Chart from './Chart.astro';
import CriteriaDetail from './CriteriaDetail.astro';
import FondBadge from './FondBadge.astro';
import type { Dataset } from '../data/types';
import data from '../data/proiecte-imobiliare/scores.json';
import { dbSource, db } from '../data/radar';
import type { Lang } from '../data/i18n';
import { WHY_EN, SOURCE_TITLE_EN, PROJECT_REGION_EN, KIND_EN, inputEn } from '../data/en-content';
import { fmtDate as fd, num as nm, sourceL } from '../data/lang';

interface Props { lang?: Lang }
const { lang = 'ro' } = Astro.props;
const en = lang === 'en';
const L = (ro: string, e: string) => (en ? e : ro);

const base = import.meta.env.BASE_URL;
type Row = { id: string; name: string; nameEn?: string; stage: string; stageEn?: string; region: string; kind: string; kindEn?: string; c: (number | null)[]; why: string; sources: [string, string][]; inputs: Record<string, string>; score: number; met: number; v?: (number | null)[]; trust?: number; met14?: number; vwhy?: string; vwhyEn?: string; price?: { symbol: string; url: string; points: [string, number][] } };
const rows = (data.rows as unknown as Row[]).map((r) => (en ? { ...r, vwhy: r.vwhyEn ?? r.vwhy, name: r.nameEn ?? r.name, stage: r.stageEn ?? r.stage, kind: r.kindEn ?? KIND_EN[r.kind] ?? r.kind, region: PROJECT_REGION_EN[r.region] ?? r.region, why: WHY_EN['proiecte-imobiliare'][r.id] ?? r.why, sources: r.sources.map(([t, u]) => [SOURCE_TITLE_EN[t] ?? t, u] as [string, string]), inputs: Object.fromEntries(Object.entries(r.inputs).map(([k, v]) => [k, inputEn(v)])) } : r));
const listedOf = (r: Row) => r.stage.startsWith('Listată') || r.stage.startsWith('Listed');
const fmtDate = (d: string) => fd(d, lang);
const num = (x: number, d = 2) => nm(x, d, lang);
const zone = (k: number) => (k >= 16 ? 'puternic' : k >= 10 ? 'observatie' : 'slab');
const tzone = (k: number) => (k >= 6 ? 'puternic' : k >= 4 ? 'observatie' : 'slab');
const snap = (data as { snapshot?: string }).snapshot ?? `proiecte-imobiliare-${data.date}`;
const prev = (data as { previousSnapshot?: string }).previousSnapshot;

const metChart: Dataset = {
  id: 'pi-conditii', domain: 'proiecte-imobiliare', title: L('Condiții îndeplinite din 22, pe proiecte', 'Conditions met out of 22, by project'), unit: L('condiții', 'conditions'), chart: 'bar',
  series: [{ name: L('Condiții îndeplinite', 'Conditions met'), points: rows.map((r) => [r.name.replace(/ \(.*\)$/, ''), r.met]) }],
  source: sourceL({ name: 'Radar Active Explozive, instantaneul proiectelor imobiliare', url: 'https://github.com/TatisiAdrian/radar-active-explozive/blob/main/scripts/proiecte-imobiliare.json', retrievedAt: data.date }, lang),
  notes: L('Notele și sursa fiecăreia sunt în detaliile de mai jos.', 'The scores and the source of each are in the details below.'),
};
const listed = rows.filter((r) => r.price?.points.length);
const bench = db.benchmarks.sp500;
const priceChart: Dataset | undefined = listed.length ? {
  id: 'pi-preturi', domain: 'proiecte-imobiliare', title: L('Companiile listate din spatele proiectelor, săptămânal, față de S&P 500', 'The listed companies behind the projects, weekly, against the S&P 500'), unit: L('indice, prima săptămână = 100', 'index, first week = 100'), chart: 'line',
  series: [
    ...listed.map((r) => ({ name: `${r.name.replace(/ \(.*\)$/, '')} (${r.price!.symbol})`, points: r.price!.points.map(([d, v]) => [d, +((v / r.price!.points[0][1]) * 100).toFixed(2)] as [string, number]) })),
    ...(bench ? [{ name: L('S&P 500 (reper)', 'S&P 500 (benchmark)'), points: bench.points.map(([d, v]) => [d, +((v / bench.points[0][1]) * 100).toFixed(2)] as [string, number]) }] : []),
  ],
  source: sourceL(dbSource, lang),
  notes: L('Fiecare acțiune e în moneda bursei pe care se tranzacționează (USD, EUR, AED, JPY, HKD, RON).', 'Each share is in the currency of the exchange it trades on (USD, EUR, AED, JPY, HKD, RON).'),
} : undefined;
const top = rows[0];
const unlisted = rows.filter((r) => !listedOf(r));
const formOnly = rows.filter((r) => (r.met14 ?? r.met) <= 2).map((r) => r.name);
---
<section id="radar">
  <h2>{L('Proiectele de pe radar', 'The projects on the radar')}</h2>
  <p>
    {en ? <>{rows.length} real-estate projects of worldwide interest, scored on 22 conditions: 14 adapted conditions (80% of the score) and 8 verification conditions (20%), which check whether the figures can be confirmed independently: outside audit or ranking, official registers, agreement of sources, track record, third-party confirmation, warning signs, resilience under stress and independence from 22Radar. Each score rests on public sources, listed for each project. The scores are frozen in the{' '}<a href={`${base}snapshots/${snap}.json`}>snapshot of {fmtDate(data.date)}</a>{' '}(fingerprint in the <a href={`${base}snapshots/${snap}.sha256`}>.sha256 file</a>){prev && <>; the earlier 14-condition snapshot stays published: <a href={`${base}snapshots/${prev}.json`}>{prev}.json</a></>}. For the listed companies, the trend (C12) is computed from the weekly price. Price conditions cannot be assessed for state or unlisted projects: they get 5 (neutral) in the score and do not count as met.</>
      : <>{rows.length} proiecte imobiliare de interes mondial, notate pe 22 de condiții: 14 condiții adaptate (80% din scor) și 8 condiții de verificare (20%), care arată dacă cifrele se pot confirma independent: audit sau clasament extern, registre oficiale, concordanța surselor, istoric, confirmare de la terți, semnale de alarmă, rezistență la stres și independență față de 22Radar. Fiecare notă se sprijină pe surse publice, listate la fiecare proiect. Notele sunt înghețate în{' '}<a href={`${base}snapshots/${snap}.json`}>instantaneul din {fmtDate(data.date)}</a>{' '}(amprenta în <a href={`${base}snapshots/${snap}.sha256`}>fișierul .sha256</a>){prev && <>; instantaneul anterior, cu 14 condiții, rămâne publicat: <a href={`${base}snapshots/${prev}.json`}>{prev}.json</a></>}. Pentru companiile listate, trendul (C12) se calculează din prețul săptămânal. Condițiile de preț nu se pot evalua la proiectele de stat sau nelistate: primesc 5 (neutru) în scor și nu sunt considerate îndeplinite.</>}
  </p>
  <div class="table-wrap">
    <table class="radar fx">
      <thead><tr><th>#</th><th>{L('Proiectul', 'Project')}</th><th>{L('Tip', 'Type')}</th><th>{L('Unde', 'Where')}</th><th>{L('Cum ajungi la el', 'How to reach it')}</th><th>{L('Condiții', 'Conditions')}</th><th>{L('Verificare', 'Verification')}</th><th>{L('Scor', 'Score')}</th><th>{L('Fond / formă', 'Substance / form')}</th></tr></thead>
      <tbody>
        {rows.map((r, i) => (
          <tr>
            <td class="muted">{i + 1}</td>
            <td><b>{r.name}</b></td>
            <td class="muted">{r.kind}</td>
            <td class="muted">{r.region}</td>
            <td class="muted">{r.stage}</td>
            <td><span class:list={['k', zone(r.met)]}>{r.met}/22</span><span class="kbar" aria-hidden="true"><i style={`width:${(r.met / 22) * 100}%`} class={zone(r.met)}></i></span></td>
            <td><span class:list={['k', tzone(r.trust ?? 0)]}>{r.trust}/8</span></td>
            <td>{num(r.score)}</td>
            <td><FondBadge values={r.c} lang={lang} /></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3>{L('Fiecare proiect, condiție cu condiție', 'Each project, condition by condition')}</h3>
  {rows.map((r) => (
    <details class="fxd">
      <summary><b>{r.name}</b> · {r.stage} · <span class:list={['k', zone(r.met)]}>{r.met}/22</span> · {L('verificare', 'verification')} {r.trust}/8 · {L('scor', 'score')} {num(r.score)} · <FondBadge values={r.c} lang={lang} /></summary>
      <p>{r.why}</p>
      <CriteriaDetail set="proiecte-imobiliare" values={r.c} inputs={r.inputs} lang={lang} />
      <h4>{L('Verificare (C15–C22)', 'Verification (C15–C22)')}</h4>
      {r.vwhy && <p>{r.vwhy}</p>}
      <CriteriaDetail set="verificare" values={r.v ?? []} lang={lang} offset={14} />
      <p class="muted">{L('Surse', 'Sources')}: {r.sources.map(([t, u], i) => <>{i > 0 && '; '}<a href={u} target="_blank" rel="noopener">{t}</a></>)}</p>
    </details>
  ))}
</section>

<section>
  <h2>{L('Datele din spatele notelor', 'The data behind the scores')}</h2>
  <Chart dataset={metChart} lang={lang} />
  {priceChart && <Chart dataset={priceChart} height={460} lang={lang} />}
</section>

<section>
  <h2>{L('Ce arată analiza', 'What the analysis shows')}</h2>
  {en ? (
    <p>
      <b>{top.name}</b> meets the most conditions ({top.met} of 22).{' '}
      The projects with solid substance are the ones that meet a clear need and already have paying tenants: data centres for artificial intelligence, logistics, housing in markets with a shortage.{' '}
      {unlisted.length} of {rows.length} projects cannot be bought directly; we follow them because they show where states’ money goes and what happens when form comes before substance.{' '}
      {formOnly.length > 0 && <>The weakest: {formOnly.join(', ')}.</>}
    </p>
  ) : (
    <p>
      <b>{top.name}</b> îndeplinește cele mai multe condiții ({top.met} din 22).{' '}
      Proiectele cu fond solid sunt cele care răspund unei nevoi clare și au deja chiriași care plătesc: centre de date pentru inteligența artificială, logistică, locuințe în piețe cu deficit.{' '}
      {unlisted.length} din {rows.length} proiecte nu se pot cumpăra direct; le urmărim pentru că arată unde se duc banii statelor și ce se întâmplă când forma vine înaintea fondului.{' '}
      {formOnly.length > 0 && <>Cele mai slabe: {formOnly.join(', ')}.</>}
    </p>
  )}
  <p class="notice">
    {L('Un proiect spectaculos nu e o investiție bună în sine. Contează cine locuiește sau lucrează acolo, cine plătește chiria și cât datorează dezvoltatorul. Nu este o recomandare de investiții.',
      'A spectacular project is not a good investment in itself. What matters is who lives or works there, who pays the rent and how much the developer owes. This is not investment advice.')}
  </p>
</section>
