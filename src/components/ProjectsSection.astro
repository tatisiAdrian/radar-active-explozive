---
import Chart from './Chart.astro';
import CriteriaDetail from './CriteriaDetail.astro';
import FondBadge from './FondBadge.astro';
import type { Dataset } from '../data/types';
import data from '../data/proiecte-imobiliare/scores.json';
import { dbSource, db } from '../data/radar';

const base = import.meta.env.BASE_URL;
type Row = { id: string; name: string; stage: string; region: string; kind: string; c: (number | null)[]; why: string; sources: [string, string][]; inputs: Record<string, string>; score: number; met: number; price?: { symbol: string; url: string; points: [string, number][] } };
const rows = data.rows as unknown as Row[];
const fmtDate = (d: string) => new Date(d + 'T00:00:00Z').toLocaleDateString('ro-RO', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const num = (x: number, d = 2) => x.toLocaleString('ro-RO', { maximumFractionDigits: d, minimumFractionDigits: d });
const zone = (k: number) => (k >= 10 ? 'puternic' : k >= 6 ? 'observatie' : 'slab');

const metChart: Dataset = {
  id: 'pi-conditii', domain: 'proiecte-imobiliare', title: 'Condiții îndeplinite din 14, pe proiecte', unit: 'condiții', chart: 'bar',
  series: [{ name: 'Condiții îndeplinite', points: rows.map((r) => [r.name.replace(/ \(.*\)$/, ''), r.met]) }],
  source: { name: 'Radar Active Explozive, instantaneul proiectelor imobiliare', url: 'https://github.com/TatisiAdrian/radar-active-explozive/blob/main/scripts/proiecte-imobiliare.json', retrievedAt: data.date },
  notes: 'Notele și sursa fiecăreia sunt în detaliile de mai jos.',
};
const listed = rows.filter((r) => r.price?.points.length);
const bench = db.benchmarks.sp500;
const priceChart: Dataset | undefined = listed.length ? {
  id: 'pi-preturi', domain: 'proiecte-imobiliare', title: 'Companiile listate din spatele proiectelor, săptămânal, față de S&P 500', unit: 'indice, prima săptămână = 100', chart: 'line',
  series: [
    ...listed.map((r) => ({ name: `${r.name.replace(/ \(.*\)$/, '')} (${r.price!.symbol})`, points: r.price!.points.map(([d, v]) => [d, +((v / r.price!.points[0][1]) * 100).toFixed(2)] as [string, number]) })),
    ...(bench ? [{ name: 'S&P 500 (reper)', points: bench.points.map(([d, v]) => [d, +((v / bench.points[0][1]) * 100).toFixed(2)] as [string, number]) }] : []),
  ],
  source: dbSource,
  notes: 'Fiecare acțiune e în moneda bursei pe care se tranzacționează (USD, EUR, AED, JPY, HKD, RON).',
} : undefined;
const top = rows[0];
const unlisted = rows.filter((r) => !r.stage.startsWith('Listată'));
const formOnly = rows.filter((r) => r.met <= 2).map((r) => r.name);
---
<section id="radar">
  <h2>Proiectele de pe radar</h2>
  <p>
    {rows.length} proiecte imobiliare de interes mondial, notate pe 14 condiții adaptate. Fiecare notă se sprijină pe surse publice, listate la fiecare proiect.
    Notele sunt înghețate în{' '}<a href={`${base}snapshots/proiecte-imobiliare-${data.date}.json`}>instantaneul din {fmtDate(data.date)}</a>{' '}
    (amprenta în <a href={`${base}snapshots/proiecte-imobiliare-${data.date}.sha256`}>fișierul .sha256</a>).
    Pentru companiile listate, trendul (C12) se calculează din prețul săptămânal. Condițiile de preț nu se pot evalua la proiectele de stat sau nelistate: primesc 5 (neutru) în scor și nu sunt considerate îndeplinite.
  </p>
  <div class="table-wrap">
    <table class="radar fx">
      <thead><tr><th>#</th><th>Proiectul</th><th>Tip</th><th>Unde</th><th>Cum ajungi la el</th><th>Condiții</th><th>Scor</th><th>Fond / formă</th></tr></thead>
      <tbody>
        {rows.map((r, i) => (
          <tr>
            <td class="muted">{i + 1}</td>
            <td><b>{r.name}</b></td>
            <td class="muted">{r.kind}</td>
            <td class="muted">{r.region}</td>
            <td class="muted">{r.stage}</td>
            <td><span class:list={['k', zone(r.met)]}>{r.met}/14</span><span class="kbar" aria-hidden="true"><i style={`width:${(r.met / 14) * 100}%`} class={zone(r.met)}></i></span></td>
            <td>{num(r.score)}</td>
            <td><FondBadge values={r.c} /></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3>Fiecare proiect, condiție cu condiție</h3>
  {rows.map((r) => (
    <details class="fxd">
      <summary><b>{r.name}</b> · {r.stage} · <span class:list={['k', zone(r.met)]}>{r.met}/14</span> · scor {num(r.score)} · <FondBadge values={r.c} /></summary>
      <p>{r.why}</p>
      <CriteriaDetail set="proiecte-imobiliare" values={r.c} inputs={r.inputs} />
      <p class="muted">Surse: {r.sources.map(([t, u], i) => <>{i > 0 && '; '}<a href={u} target="_blank" rel="noopener">{t}</a></>)}</p>
    </details>
  ))}
</section>

<section>
  <h2>Datele din spatele notelor</h2>
  <Chart dataset={metChart} />
  {priceChart && <Chart dataset={priceChart} height={460} />}
</section>

<section>
  <h2>Ce arată analiza</h2>
  <p>
    <b>{top.name}</b> îndeplinește cele mai multe condiții ({top.met} din 14).{' '}
    Proiectele cu fond solid sunt cele care răspund unei nevoi clare și au deja chiriași care plătesc: centre de date pentru inteligența artificială, logistică, locuințe în piețe cu deficit.{' '}
    {unlisted.length} din {rows.length} proiecte nu se pot cumpăra direct; le urmărim pentru că arată unde se duc banii statelor și ce se întâmplă când forma vine înaintea fondului.{' '}
    {formOnly.length > 0 && <>Cele mai slabe: {formOnly.join(', ')}.</>}
  </p>
  <p class="notice">
    Un proiect spectaculos nu e o investiție bună în sine. Contează cine locuiește sau lucrează acolo, cine plătește chiria și cât datorează dezvoltatorul. Nu este o recomandare de investiții.
  </p>
</section>
