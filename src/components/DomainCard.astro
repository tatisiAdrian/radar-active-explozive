---
import type { Domain } from '../data/types';
import { domainHref, domainTitle, domainSummary } from '../data/lang';
interface Props { domain: Domain; lang?: 'ro' | 'en' }
const { domain, lang = 'ro' } = Astro.props;
const en = lang === 'en';
---
<a class="card" href={domainHref(domain.slug, lang)}>
  <span class:list={['badge', domain.status]}>{domain.status === 'activ' ? (en ? 'Active' : 'Activ') : (en ? 'Planned' : 'Planificat')}</span>
  <h3>{domainTitle(domain, lang)}</h3>
  <p>{domainSummary(domain, lang)}</p>
</a>
