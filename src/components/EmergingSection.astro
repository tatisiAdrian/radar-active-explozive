---
import Chart from './Chart.astro';
import CriteriaDetail from './CriteriaDetail.astro';
import FondBadge from './FondBadge.astro';
import type { Dataset, Source } from '../data/types';
import type { Lang } from '../data/i18n';
import { COUNTRY_EN } from '../data/i18n';
import { WHY_EN, FORMULAS_EN, inputEn } from '../data/en-content';
import { fmtDate as fd, num as nm, sourceL } from '../data/lang';
import scores from '../data/emerging/scores.json';
import macro from '../data/emerging/macro.json';

interface Props { lang?: Lang }
const { lang = 'ro' } = Astro.props;
const en = lang === 'en';
const L = (ro: string, e: string) => (en ? e : ro);
const base = import.meta.env.BASE_URL;
type Row = { id: string; name: string; score: number; met: number; v?: (number | null)[]; trust?: number; met14?: number; vwhy?: string; vwhyEn?: string; criteria: (number | null)[]; inputs: Record<string, string>; gaps: string[]; why: string };
const rows = (scores.rows as unknown as Row[]).map((r) => (en ? { ...r, vwhy: r.vwhyEn ?? r.vwhy, name: COUNTRY_EN[r.id] ?? r.name, why: WHY_EN['economii-emergente'][r.id] ?? r.why, inputs: Object.fromEntries(Object.entries(r.inputs).map(([k, v]) => [k, inputEn(v)])) } : r));
const SNAP = scores.judgmentDate;
const fmtDate = (d: string) => fd(d, lang);
const num = (x: number, d = 1) => nm(x, d, lang);
const pct = (x: number | undefined) => (x === undefined ? '—' : `${x > 0 ? '+' : ''}${num(x)}%`);
const zone = (k: number) => (k >= 16 ? 'puternic' : k >= 10 ? 'observatie' : 'slab');
const tzone = (k: number) => (k >= 6 ? 'puternic' : k >= 4 ? 'observatie' : 'slab');
const snap = (scores as { snapshot?: string }).snapshot ?? `emergente-${SNAP}`;
const prev = (scores as { previousSnapshot?: string }).previousSnapshot;
const formulas = en ? FORMULAS_EN['economii-emergente'] : scores.formulas;

const src = (s: { name: string; url: string; retrievedAt: string }): Source => sourceL(s, lang);
const fx = macro.fx as unknown as Record<string, { points: [string, number][]; unit: string; symbol: string; url: string }>;
const imf = macro.imf as unknown as Record<string, { label: string; values: Record<string, Record<string, number>> }>;
const y26 = (ind: string, c: string) => imf[ind]?.values[c]?.['2026'];
const order = rows.map((r) => r.id);
const nameOf = Object.fromEntries(rows.map((r) => [r.id, r.name]));

const growth: Dataset = {
  id: 'em-crestere', domain: 'economii-emergente', title: L('Creșterea PIB real în 2026 (estimare FMI)', 'Real GDP growth in 2026 (IMF estimate)'), unit: '%', chart: 'bar',
  series: [{ name: L('Creștere PIB real', 'Real GDP growth'), points: order.filter((c) => y26('NGDP_RPCH', c) !== undefined).map((c) => [nameOf[c], y26('NGDP_RPCH', c)!]) }],
  source: src(macro.sources.imf),
};
const fiscal: Dataset = {
  id: 'em-buget-datorie', domain: 'economii-emergente', title: L('Soldul bugetar și contul curent în 2026 (estimări FMI)', 'Budget balance and current account in 2026 (IMF estimates)'), unit: L('% din PIB', '% of GDP'), chart: 'bar',
  series: [
    { name: L('Sold bugetar', 'Budget balance'), points: order.filter((c) => y26('GGXCNL_NGDP', c) !== undefined).map((c) => [nameOf[c], y26('GGXCNL_NGDP', c)!]) },
    { name: L('Cont curent', 'Current account'), points: order.filter((c) => y26('BCA_NGDPD', c) !== undefined).map((c) => [nameOf[c], y26('BCA_NGDPD', c)!]) },
  ],
  source: src(macro.sources.imf),
  notes: L('Valori negative = deficit. Când ambele sunt negative (deficite gemene), țara depinde de finanțare externă.', 'Negative values = deficit. When both are negative (twin deficits), the country depends on foreign financing.'),
};
const markets: Dataset = {
  id: 'em-burse', domain: 'economii-emergente', title: L('Bursa fiecărei țări, săptămânal (ETF de țară în USD; pentru România, ETF-ul pe indicele BET, în lei)', 'Each country’s stock market, weekly (country ETF in USD; for Romania, the BET index ETF, in lei)'), unit: L('indice, prima săptămână = 100', 'index, first week = 100'), chart: 'line',
  series: [...order, 'EM'].filter((c) => fx[c]?.points.length).map((c) => ({
    name: c === 'EM' ? L('Toate piețele emergente (EEM, reper)', 'All emerging markets (EEM, benchmark)') : `${nameOf[c]} (${fx[c].symbol})`,
    points: fx[c].points.map(([d, v]) => [d, +((v / fx[c].points[0][1]) * 100).toFixed(2)] as [string, number]),
  })),
  source: src(macro.sources.fx),
  notes: L('ETF-urile de țară sunt cotate în dolari, deci includ și mișcarea monedei locale; ETF-ul românesc (TVBETETF.RO) e cotat în lei. Egipt: fără date bursiere zilnice la sursă.', 'Country ETFs are quoted in dollars, so they also include the local currency’s move; the Romanian ETF (TVBETETF.RO) is quoted in lei. Egypt: no daily stock-market data at the source.'),
};

const g = growth.series[0].points;
const twin = order.filter((c) => (y26('GGXCNL_NGDP', c) ?? 0) < -3 && (y26('BCA_NGDPD', c) ?? 0) < -3).map((c) => nameOf[c]);
const top = rows[0];
const ro = rows.find((r) => r.id === 'RO');
const fastest = [...g].sort((a, b) => b[1] - a[1]).slice(0, 3);
const c12 = (s?: string) => (s ? s.replace('bursa ', '').replace(' în două luni', '').replace('the stock market ', '').replace(' in two months', '') : '—');
---
<section id="radar">
  <h2>{L('Economiile de pe radar', 'The economies on the radar')}</h2>
  <p>
    {en ? <>{rows.length} emerging economies scored on 22 conditions: 14 (80% of the score) and 8 that verify the evidence (20%): IMF reviews and credit ratings, the quality of official statistics, agreement of sources, track record, outside confirmation (ratings, index inclusion), warning signs (sanctions, capital controls, defaults, EU deficit procedures), resilience in crises and independence from 22Radar. Of the first 14, six conditions are computed automatically from official data (IMF, BIS, each country’s stock market), using published formulas; the other eight are judgement, with a rationale for each country. The scores are frozen in the{' '}<a href={`${base}snapshots/${snap}.json`}>snapshot of {fmtDate(SNAP)}</a>{' '}(SHA-256 fingerprint in the <a href={`${base}snapshots/${snap}.sha256`}>.sha256 file</a>){prev && <>; the earlier 14-condition snapshot stays published: <a href={`${base}snapshots/${prev}.json`}>{prev}.json</a></>}. The input data update automatically every Friday.</>
      : <>{rows.length} economii emergente notate pe 22 de condiții: 14 (80% din scor) și 8 care verifică dovezile (20%): evaluări FMI și ratinguri, calitatea statisticilor oficiale, concordanța surselor, istoric, confirmări externe (ratinguri, includerea în indici), semnale de alarmă (sancțiuni, controale de capital, incapacitate de plată, proceduri UE de deficit), rezistență la crize și independență față de 22Radar. Din primele 14, șase condiții se calculează automat din date oficiale (FMI, BIS, bursa fiecărei țări), după formule publice; celelalte opt sunt judecată, cu justificare pentru fiecare țară. Notele sunt înghețate în{' '}<a href={`${base}snapshots/${snap}.json`}>instantaneul din {fmtDate(SNAP)}</a>{' '}(amprenta SHA-256 în <a href={`${base}snapshots/${snap}.sha256`}>fișierul .sha256</a>){prev && <>; instantaneul anterior, cu 14 condiții, rămâne publicat: <a href={`${base}snapshots/${prev}.json`}>{prev}.json</a></>}. Datele de intrare se actualizează automat în fiecare vineri.</>}
  </p>
  <div class="table-wrap">
    <table class="radar fx">
      <thead><tr><th>#</th><th>{L('Țara', 'Country')}</th><th>{L('Condiții', 'Conditions')}</th><th>{L('Verificare', 'Verification')}</th><th>{L('Scor', 'Score')}</th><th>{L('Fond / formă', 'Substance / form')}</th><th>{L('Creștere 2026', 'Growth 2026')}</th><th>{L('Sold bugetar', 'Budget balance')}</th><th>{L('Datorie publică', 'Public debt')}</th><th>{L('Bursa, 2 luni', 'Stocks, 2 months')}</th></tr></thead>
      <tbody>
        {rows.map((r, i) => (
          <tr>
            <td class="muted">{i + 1}</td>
            <td><b>{r.name}</b></td>
            <td><span class:list={['k', zone(r.met)]}>{r.met}/22</span><span class="kbar" aria-hidden="true"><i style={`width:${(r.met / 22) * 100}%`} class={zone(r.met)}></i></span></td>
            <td><span class:list={['k', tzone(r.trust ?? 0)]}>{r.trust}/8</span></td>
            <td>{num(r.score, 2)}</td>
            <td><FondBadge values={r.criteria} lang={lang} /></td>
            <td class="num">{pct(y26('NGDP_RPCH', r.id))}</td>
            <td class="num">{pct(y26('GGXCNL_NGDP', r.id))}</td>
            <td class="num">{y26('GGXWDG_NGDP', r.id) !== undefined ? `${num(y26('GGXWDG_NGDP', r.id)!, 0)}%` : '—'}</td>
            <td class="num">{c12(r.inputs.C12)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3>{L('Fiecare țară, condiție cu condiție', 'Each country, condition by condition')}</h3>
  <p class="muted">{L('Deschide o țară ca să vezi nota la fiecare condiție, datele din spatele notelor calculate și justificarea notelor de judecată. Condițiile fără date primesc 5 (neutru) în scor și nu sunt considerate îndeplinite.', 'Open a country to see the score on each condition, the data behind the computed scores and the rationale for the judgement scores. Conditions without data get 5 (neutral) in the score and do not count as met.')}</p>
  {rows.map((r) => (
    <details class="fxd">
      <summary><b>{r.name}</b> · <span class:list={['k', zone(r.met)]}>{r.met}/22</span> · {L('verificare', 'verification')} {r.trust}/8 · {L('scor', 'score')} {num(r.score, 2)} · <FondBadge values={r.criteria} lang={lang} />{r.gaps.length > 0 && <span class="muted"> · {L('fără date', 'no data')}: {r.gaps.join(', ')}</span>}</summary>
      <p>{r.why}</p>
      <CriteriaDetail set="economii-emergente" values={r.criteria} inputs={r.inputs} lang={lang} />
      <h4>{L('Verificare (C15–C22)', 'Verification (C15–C22)')}</h4>
      {r.vwhy && <p>{r.vwhy}</p>}
      <CriteriaDetail set="verificare" values={r.v ?? []} lang={lang} offset={14} />
    </details>
  ))}

  <h3>{L('Formulele condițiilor calculate', 'Formulas for the computed conditions')}</h3>
  <ul class="formulas">
    {Object.entries(formulas).map(([k, f]) => <li><b>{k}</b>: {f}</li>)}
  </ul>
</section>

<section>
  <h2>{L('Datele din spatele notelor', 'The data behind the scores')}</h2>
  <Chart dataset={growth} lang={lang} />
  <Chart dataset={fiscal} lang={lang} />
  <Chart dataset={markets} height={460} lang={lang} />
</section>

<section>
  <h2>{L('Ce arată datele', 'What the data show')}</h2>
  <p class="muted">{L('Paragraf calculat automat din datele de mai sus; se actualizează odată cu ele.', 'A paragraph computed automatically from the data above; it updates with them.')}</p>
  {en ? (
    <p>
      <b>{top.name}</b> meets the most conditions ({top.met} of 22).{' '}
      The fastest growth estimated by the IMF for 2026: {fastest.map(([n, v]) => `${n} (${pct(v)})`).join(', ')}.{' '}
      {twin.length > 0 && <>Twin deficits above 3% of GDP (budget and current account): {twin.join(', ')}.{' '}</>}
      {ro && <>Romania ranks {rows.indexOf(ro) + 1} of {rows.length}, with {ro.met} {ro.met === 1 ? 'condition' : 'conditions'} met: {ro.inputs.C1}, {ro.inputs.C2}, {ro.inputs.C3}.</>}
    </p>
  ) : (
    <p>
      <b>{top.name}</b> îndeplinește cele mai multe condiții ({top.met} din 22).{' '}
      Cea mai rapidă creștere estimată de FMI pentru 2026: {fastest.map(([n, v]) => `${n} (${pct(v)})`).join(', ')}.{' '}
      {twin.length > 0 && <>Deficite gemene de peste 3% din PIB (buget și cont curent): {twin.join(', ')}.{' '}</>}
      {ro && <>România e pe locul {rows.indexOf(ro) + 1} din {rows.length}, cu {ro.met} {ro.met === 1 ? 'condiție îndeplinită' : 'condiții îndeplinite'}: {ro.inputs.C1}, {ro.inputs.C2}, {ro.inputs.C3}.</>}
    </p>
  )}
  <p class="notice">
    {L('Creșterea rapidă nu e suficientă: o economie cu deficite mari depinde de investitorii străini și e vulnerabilă când aceștia pleacă. De aceea notăm împreună creșterea, finanțele publice, instituțiile și riscul geopolitic. Nu este o recomandare de investiții.',
      'Fast growth is not enough: an economy with large deficits depends on foreign investors and is vulnerable when they leave. That is why we score growth, public finances, institutions and geopolitical risk together. This is not investment advice.')}
  </p>
</section>
