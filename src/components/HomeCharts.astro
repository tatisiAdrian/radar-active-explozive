---
import { itemsFor, byRank } from '../data/home';
import { overviewFor } from '../data/overview';
import type { Lang } from '../data/i18n';

interface Props { lang?: Lang; only?: string[] }
const { lang = 'ro', only } = Astro.props;
const en = lang === 'en';
const ITEMS = itemsFor(lang, only);
const OVERVIEW = overviewFor(lang, only);
import { assets } from '../data/radar';

const top = [...ITEMS].sort(byRank).slice(0, 10);
const pctOf = (k: number) => (k / 14) * 100;
const zones = OVERVIEW.map((d) => {
  const xs = ITEMS.filter((i) => i.domain === d.slug);
  return {
    d, n: xs.length,
    strong: xs.filter((x) => x.met >= 10).length,
    watch: xs.filter((x) => x.met >= 6 && x.met < 10).length,
    weak: xs.filter((x) => x.met < 6).length,
    avg: xs.reduce((s, x) => s + x.met, 0) / (xs.length || 1),
  };
});
const avgOf = (gs: string[]) => {
  const xs = assets.filter((a) => gs.includes(a.g));
  return xs.reduce((s, a) => s + a.k, 0) / (xs.length || 1);
};
const pairs = [
  { dom: 'crypto', label: en ? 'Crypto · not launched vs. launched' : 'Crypto · nelansate vs. lansate', before: avgOf(['pre']), after: avgOf(['post']) },
  { dom: 'startups', label: en ? 'Companies · pre-IPO vs. listed' : 'Companii · pre-IPO vs. listate', before: avgOf(['preipo']), after: avgOf(['ipo']) },
  { dom: 'startups', label: en ? 'Start-ups · without vs. with product' : 'Start-ups · fără vs. cu produs', before: avgOf(['seed']), after: avgOf(['startup']) },
  { dom: 'marfuri', label: en ? 'Commodities · emerging vs. mature' : 'Mărfuri · emergente vs. mature', before: avgOf(['emerging']), after: avgOf(['mature']) },
].filter((p) => !only || only.includes(p.dom));
const isMacro = !!only && !only.includes('crypto');
const T = en
  ? { h1: only ? 'Top 10 in this category' : 'Top 10 assets, across all domains', p1: 'The dashed green line marks the 10-condition threshold, from which an asset becomes a strong candidate.', of: 'of 14 conditions', h2: 'How many assets sit in each zone', p2: 'Most assets do not gather enough conditions. That is normal: we are looking for the exceptions.', with: 'with 10+', watch: 'on watch', under: 'under 6', l1: '10+ of 14', h3: 'Average conditions met, by domain', p3: 'How “full” each domain is, on average, out of the 14 conditions.', h4: only && !only.includes('crypto') ? 'Emerging vs. mature' : 'Before vs. after launch', p4: pairsNote(true), before: isMacro ? 'emerging' : 'before', after: isMacro ? 'mature' : 'after' }
  : { h1: only ? 'Top 10 din această categorie' : 'Top 10 active, din toate domeniile', p1: 'Linia verde punctată marchează pragul de 10 condiții, de la care un activ devine candidat puternic.', of: 'din 14 condiții', h2: 'Câte active sunt în fiecare zonă', p2: 'Cele mai multe active nu adună destule condiții. E normal: căutăm excepțiile.', with: 'cu 10+', watch: 'în observație', under: 'sub 6', l1: '10+ din 14', h3: 'Media condițiilor îndeplinite, pe domeniu', p3: 'Cât de „plin” e fiecare domeniu, în medie, din cele 14 condiții.', h4: only && !only.includes('crypto') ? 'Emergente vs. mature' : 'Înainte vs. după lansare', p4: pairsNote(false), before: isMacro ? 'emergente' : 'înainte', after: isMacro ? 'mature' : 'după' };
function pairsNote(e: boolean) {
  const macro = only && !only.includes('crypto');
  if (macro) return e ? 'Average conditions met: emerging commodities (rare earths, gallium, GPU hours) versus mature ones (oil, gold, wheat).' : 'Media condițiilor îndeplinite: mărfurile emergente (pământuri rare, galiu, ore GPU) față de cele mature (petrol, aur, grâu).';
  return e ? 'Average conditions met. Good projects that have not launched yet often tick more conditions.' : 'Media condițiilor îndeplinite. Proiectele bune care încă nu s-au lansat bifează, adesea, mai multe condiții.';
}
const n1 = (x: number) => x.toLocaleString(en ? 'en-GB' : 'ro-RO', { maximumFractionDigits: 1, minimumFractionDigits: 1 });
---
<div class="hc-grid">
  <figure class="hc">
    <h3>{T.h1}</h3>
    <p class="muted">{T.p1}</p>
    <div class="bars">
      {top.map((t) => (
        <div class="bar-row" title={`${t.name}: ${t.met} ${T.of} (${t.dshort})`}>
          <span class="bar-name">{t.name}<small style={`color:${t.color}`}>{t.dshort}</small></span>
          <span class="bar-track"><i style={`width:${pctOf(t.met)}%;background:${t.color}`}></i><em class="thr" style={`left:${pctOf(10)}%`}></em></span>
          <b>{t.met}/14</b>
        </div>
      ))}
    </div>
  </figure>

  <figure class="hc">
    <h3>{T.h2}</h3>
    <p class="muted">{T.p2}</p>
    <div class="bars">
      {zones.map((z) => (
        <div class="bar-row" title={`${z.d.title}: ${z.strong} ${T.with}, ${z.watch} ${T.watch}, ${z.weak} ${T.under}`}>
          <span class="bar-name">{z.d.short}</span>
          <span class="stack">
            {z.strong > 0 && <i class="z-s" style={`flex:${z.strong}`}>{z.strong}</i>}
            {z.watch > 0 && <i class="z-w" style={`flex:${z.watch}`}>{z.watch}</i>}
            {z.weak > 0 && <i class="z-x" style={`flex:${z.weak}`}>{z.weak}</i>}
          </span>
          <b>{z.n}</b>
        </div>
      ))}
    </div>
    <p class="legend"><span><i class="z-s"></i>{T.l1}</span><span><i class="z-w"></i>6–9</span><span><i class="z-x"></i>{T.under}</span></p>
  </figure>

  <figure class="hc">
    <h3>{T.h3}</h3>
    <p class="muted">{T.p3}</p>
    <div class="bars">
      {[...zones].sort((a, b) => b.avg - a.avg).map((z) => (
        <div class="bar-row">
          <span class="bar-name">{z.d.short}</span>
          <span class="bar-track"><i style={`width:${pctOf(z.avg)}%;background:${z.d.color}`}></i></span>
          <b>{n1(z.avg)}</b>
        </div>
      ))}
    </div>
  </figure>

  <figure class="hc">
    <h3>{T.h4}</h3>
    <p class="muted">{T.p4}</p>
    <div class="pairs">
      {pairs.map((p) => (
        <div class="pair">
          <span class="bar-name">{p.label}</span>
          <div class="bar-row sm"><span class="tag">{T.before}</span><span class="bar-track"><i class="pre" style={`width:${pctOf(p.before)}%`}></i></span><b>{n1(p.before)}</b></div>
          <div class="bar-row sm"><span class="tag">{T.after}</span><span class="bar-track"><i class="post" style={`width:${pctOf(p.after)}%`}></i></span><b>{n1(p.after)}</b></div>
        </div>
      ))}
    </div>
  </figure>
</div>

<style>
  .hc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .hc { margin: 0; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.2rem 1.25rem; }
  .hc h3 { margin: 0 0 .25rem; font-size: 1.1rem; }
  .hc > p { margin: 0 0 1rem; font-size: .88rem; }
  .bars { display: grid; gap: .5rem; }
  .bar-row { display: grid; grid-template-columns: minmax(0, 11rem) 1fr 3rem; align-items: center; gap: .6rem; font-size: .88rem; }
  .bar-row b { font: 600 .85rem var(--f-mono); text-align: right; }
  .bar-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bar-name small { margin-left: .4rem; font: 600 .7rem var(--f-mono); }
  .bar-track { position: relative; height: 12px; background: color-mix(in srgb, var(--border) 60%, transparent); border-radius: 6px; }
  .bar-track i { position: absolute; inset: 0 auto 0 0; border-radius: 6px; }
  .thr { position: absolute; top: -4px; bottom: -4px; border-left: 2px dashed #1f9d63; }
  .stack { display: flex; height: 18px; border-radius: 6px; overflow: hidden; }
  .stack i { display: grid; place-items: center; font: 600 .7rem var(--f-mono); color: #fff; font-style: normal; min-width: 1.2rem; }
  .z-s { background: #1f9d63; } .z-w { background: #d4931f; } .z-x { background: #8a97aa; }
  .legend { display: flex; gap: 1rem; margin: .8rem 0 0; font-size: .8rem; color: var(--muted); }
  .legend i { display: inline-block; width: .7rem; height: .7rem; border-radius: 2px; margin-right: .3rem; vertical-align: -1px; }
  .pairs { display: grid; gap: .8rem; }
  .pair > .bar-name { display: block; font-weight: 600; font-size: .88rem; margin-bottom: .25rem; }
  .bar-row.sm { grid-template-columns: 5rem 1fr 3rem; }
  .tag { font: 500 .72rem var(--f-mono); color: var(--muted); }
  .pre { background: var(--accent); } .post { background: color-mix(in srgb, var(--accent) 40%, var(--border)); }
  @media (max-width: 900px) { .hc-grid { grid-template-columns: 1fr; } .bar-row { grid-template-columns: minmax(0, 8rem) 1fr 2.6rem; } }
</style>
