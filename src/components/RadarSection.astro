---
import Chart from './Chart.astro';
import CriteriaDetail from './CriteriaDetail.astro';
import FondBadge from './FondBadge.astro';
import type { Dataset } from '../data/types';
import {
  radarView, rebased, median, dbSource, db, GROUP, ZONE_LABEL, SNAPSHOT_DATE, BASELINE,
  COUNTRY, COUNTRY_NAME, type Market, type Zone,
} from '../data/radar';
import { GROUP_EN, type Lang } from '../data/i18n';
import { COUNTRY_NAME_EN, NO_PRICE_EN, PRICE_NOTE_EN } from '../data/en-content';
import { fmtDate as fd, locale, pctL, sourceL } from '../data/lang';

interface Props { market: Market; domain: string; countries?: string[]; lang?: Lang }
const { market, domain, countries, lang = 'ro' } = Astro.props;
const en = lang === 'en';
const L = (ro: string, e: string) => (en ? e : ro);
const nm = (a: { n: { ro: string; en: string } }) => (en ? a.n.en : a.n.ro);
const grp = (g: string) => (en ? GROUP_EN[g] : GROUP[g]) ?? g;
const cname = (c: string) => (en ? COUNTRY_NAME_EN[c] : COUNTRY_NAME[c]) ?? c;
const ZL: Record<Zone, string> = en ? { puternic: '10+ conditions', observatie: '6–9 conditions', slab: 'under 6 conditions' } : ZONE_LABEL;
const pct = (x: number | undefined) => pctL(x, lang);
const noteL = (n?: string) => (n && en ? PRICE_NOTE_EN[n] ?? n : n);
const base = import.meta.env.BASE_URL;
const v = radarView(market, countries);
const SET = market === 'comm' ? 'marfuri' : 'general';
const count = (z: Zone) => v.rows.filter((r) => r.zone === z).length;
const fmtDate = (d: string) => fd(d, lang);
const fmtPrice = (x: number) => x.toLocaleString(locale(lang), { maximumSignificantDigits: 4 });
const whyRo: Record<string, string> = {
  pre: 'nelansat încă',
  preipo: 'nelistat (piață privată)',
  startup: 'nelistat',
  seed: 'nelistat',
  ipo: 'fără sursă publică',
  post: 'sursa nu a răspuns la ultima actualizare',
  emerging: 'fără bursă lichidă',
  mature: 'fără preț zilnic public gratuit',
};

const why = en ? NO_PRICE_EN : whyRo;
const benchName = noteL(v.bench?.label) ?? L('reper', 'benchmark');
const pricesChart: Dataset | undefined = v.priced.length ? {
  id: `radar-preturi-${market}`,
  domain,
  title: L(`Prețuri săptămânale ale activelor de pe radar vs. ${benchName}`, `Weekly prices of the assets on the radar vs. ${benchName}`),
  unit: L('indice, prima săptămână = 100', 'index, first week = 100'),
  chart: 'line',
  series: [
    ...v.priced.map((r) => ({ name: nm(r.a), points: rebased(r.price!) })),
    ...(v.bench ? [{ name: `${benchName} (${L('reper', 'benchmark')})`, points: rebased(v.bench) }] : []),
  ],
  source: sourceL(dbSource, lang),
  notes: L('Fiecare serie e rebazată la 100 în prima vineri, ca să se poată compara active cu prețuri foarte diferite. Prețurile brute sunt în tabel și în fișierul sursă.', 'Each series is rebased to 100 on the first Friday, so assets with very different prices can be compared. The raw prices are in the table and in the source file.'),
} : undefined;

const retroChart: Dataset | undefined = v.priced.length ? {
  id: `radar-retro-${market}`,
  domain,
  title: L(`Variația mediană în cele ${v.priced[0].price!.points.filter((p) => p[0] <= BASELINE).length - 1} săptămâni dinaintea instantaneului, pe zone`, `Median change in the ${v.priced[0].price!.points.filter((p) => p[0] <= BASELINE).length - 1} weeks before the snapshot, by zone`),
  unit: '%',
  chart: 'bar',
  series: [{
    name: L('Variație mediană', 'Median change'),
    points: [
      ...v.byZone.filter((z) => z.n).map((z) => [`${ZL[z.z]} (${z.n})`, +z.med!.toFixed(1)] as [string, number]),
      ...(v.benchRetro !== undefined ? [[benchName, +v.benchRetro.toFixed(1)] as [string, number]] : []),
    ],
  }],
  source: sourceL(dbSource, lang),
  notes: L(`Calculat automat din baza de date: ${fmtDate(v.start)} → ${fmtDate(BASELINE)}. În paranteză, numărul de active cu preț public din fiecare zonă.`, `Computed automatically from the database: ${fmtDate(v.start)} → ${fmtDate(BASELINE)}. In brackets, the number of assets with a public price in each zone.`),
} : undefined;

const retros = v.priced.filter((r) => r.retro !== undefined);
const up = retros.filter((r) => r.retro! > 0).length;
const best = [...retros].sort((a, b) => b.retro! - a.retro!)[0];
const worst = [...retros].sort((a, b) => a.retro! - b.retro!)[0];
const medAll = median(retros.map((r) => r.retro!));
const afterRows = v.priced.filter((r) => r.after !== undefined);
const firstMeasure = new Date(Date.parse(BASELINE) + 7 * 86400000).toISOString().slice(0, 10);
---
<section id="radar">
  <h2>{L('Activele de pe radar în acest domeniu', 'The assets on the radar in this domain')}</h2>
  {en ? (
    <p>
      {v.rows.length} assets scored on the same 14 conditions: <b>{count('puternic')}</b> with 10+ conditions met,{' '}
      <b>{count('observatie')}</b> on watch (6–9) and <b>{count('slab')}</b> under 6.
      The scores are those of the{' '}frozen snapshot of {fmtDate(SNAPSHOT_DATE)}{' '}
      (<a href={`${base}snapshots/${SNAPSHOT_DATE}.json`}>JSON file with a SHA-256 fingerprint</a>).{' '}
      {v.priced.length} have a weekly public price in our database.
    </p>
  ) : (
    <p>
      {v.rows.length} active notate pe aceleași 14 condiții: <b>{count('puternic')}</b> cu 10+ condiții îndeplinite,{' '}
      <b>{count('observatie')}</b> în observație (6–9) și <b>{count('slab')}</b> sub 6.
      Notele sunt cele din{' '}instantaneul înghețat din {fmtDate(SNAPSHOT_DATE)}{' '}
      (<a href={`${base}snapshots/${SNAPSHOT_DATE}.json`}>fișier JSON cu amprentă SHA-256</a>).{' '}
      {v.priced.length} au preț public săptămânal în baza noastră de date.
    </p>
  )}
  <div class="table-wrap">
    <table class="radar">
      <thead>
        <tr>
          <th>{L('Activ', 'Asset')}</th><th>{L('Categorie', 'Category')}</th><th>{L('Condiții', 'Conditions')}</th><th>{L('Scor', 'Score')}</th><th>{L('Fond / formă', 'Substance / form')}</th>
          <th>{L('Ultimul preț', 'Last price')}</th><th title={`${fmtDate(v.start)} → ${fmtDate(BASELINE)}`}>{L('Înainte de instantaneu', 'Before the snapshot')}</th>
          <th title={`${L('de la', 'since')} ${fmtDate(BASELINE)}`}>{L('De la instantaneu', 'Since the snapshot')}</th><th>{L('Sursa prețului', 'Price source')}</th>
        </tr>
      </thead>
      <tbody>
        {v.rows.map((r) => (
          <tr>
            <td><b>{nm(r.a)}</b></td>
            <td class="muted">{grp(r.a.g)}{market === 'comp' && COUNTRY[r.a.id] && <><br /><small>{cname(COUNTRY[r.a.id])}</small></>}</td>
            <td>
              <span class:list={['k', r.zone]}>{r.a.k}/14</span>
              <span class="kbar" aria-hidden="true"><i style={`width:${(r.a.k / 14) * 100}%`} class={r.zone}></i></span>
            </td>
            <td>{r.a.s.toLocaleString(locale(lang), { maximumFractionDigits: 2 })}</td>
            <td><FondBadge values={r.a.c} lang={lang} /></td>
            {r.price ? (
              <>
                <td class="num">{fmtPrice(r.price.points.at(-1)![1])} {r.price.currency}<br /><small class="muted">{r.price.points.at(-1)![0]}</small></td>
                <td class:list={['num', (r.retro ?? 0) >= 0 ? 'pos' : 'neg']}>{pct(r.retro)}</td>
                <td class:list={['num', r.after === undefined ? 'muted' : r.after >= 0 ? 'pos' : 'neg']}>{r.after === undefined ? `${L('din', 'from')} ${firstMeasure}` : pct(r.after)}</td>
                <td><a href={r.price.url} target="_blank" rel="noopener">{r.price.provider} · {r.price.symbol}</a>{r.price.note && <><br /><small class="muted">{noteL(r.price.note)}</small></>}</td>
              </>
            ) : (
              <td colspan="4" class="muted">{L('Fără preț public', 'No public price')}: {why[r.a.g] ?? L('nedisponibil', 'unavailable')}</td>
            )}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3>{L('Fiecare activ, condiție cu condiție', 'Each asset, condition by condition')}</h3>
  <p class="muted">{L('Deschide un activ ca să vezi nota la fiecare condiție, explicată pe înțelesul oricui, și ce înseamnă pe scurt.', 'Open an asset to see the score on each condition, explained in plain words, and what it means in short.')}</p>
  {v.rows.map((r) => (
    <details class="fxd">
      <summary><b>{nm(r.a)}</b> · {grp(r.a.g)} · <span class:list={['k', r.zone]}>{r.a.k}/14</span> · <FondBadge values={r.a.c} lang={lang} /></summary>
      <p>{en ? r.a.x.en : r.a.x.ro}</p>
      <CriteriaDetail set={SET} values={r.a.c} lang={lang} />
    </details>
  ))}
</section>

{pricesChart && (
  <section>
    <h2>{L('Prețuri săptămânale (baza de date)', 'Weekly prices (the database)')}</h2>
    <p class="muted">
      {L(`În fiecare vineri, o rutină automată din GitHub descarcă închiderile din surse publice și le adaugă aici. Punctele mai vechi de o săptămână nu se mai modifică, iar fiecare actualizare rămâne în istoricul public al proiectului. Ultima actualizare: ${fmtDate(db.updatedAt)}.`,
        `Every Friday, an automated GitHub routine downloads the closes from public sources and adds them here. Points older than a week are no longer changed, and every update stays in the project’s public history. Last update: ${fmtDate(db.updatedAt)}.`)}
    </p>
    <Chart dataset={pricesChart} height={440} lang={lang} />
  </section>
)}

{retroChart && (
  <section>
    <h2>{L('Test retroactiv: ce s-a întâmplat înainte de instantaneu', 'Backtest: what happened before the snapshot')}</h2>
    <p class="notice">
      {en ? <>Read with care: the scores were given on {fmtDate(SNAPSHOT_DATE)}, <b>after</b> this period. The chart shows the context in which the scores were given, not the radar’s performance. Real performance is measured only from the snapshot onwards (next section).</>
        : <>Atenție la citire: notele au fost date pe {fmtDate(SNAPSHOT_DATE)}, <b>după</b> această perioadă. Graficul arată contextul în care au fost date notele, nu performanța radarului. Performanța reală se măsoară doar de la instantaneu încolo (secțiunea următoare).</>}
    </p>
    <Chart dataset={retroChart} lang={lang} />
    {en ? (
      <p>
        <b>Computed automatically:</b> in the two months before the snapshot, {up} of {retros.length} assets with a public price rose.{' '}
        The median change was {pct(medAll)}, against {pct(v.benchRetro)} for {benchName}.{' '}
        {best && worst && retros.length > 1 && <>{best.retro! > 0 ? 'The largest rise' : 'The smallest fall'}: {nm(best.a)} ({pct(best.retro)}); the largest fall: {nm(worst.a)} ({pct(worst.retro)}).</>}
      </p>
    ) : (
      <p>
        <b>Calculat automat:</b> în cele două luni dinaintea instantaneului, {up} din {retros.length} active cu preț public au crescut.{' '}
        Variația mediană a fost {pct(medAll)}, față de {pct(v.benchRetro)} pentru {benchName}.{' '}
        {best && worst && retros.length > 1 && <>{best.retro! > 0 ? 'Cea mai mare creștere' : 'Cea mai mică scădere'}: {nm(best.a)} ({pct(best.retro)}); cea mai mare scădere: {nm(worst.a)} ({pct(worst.retro)}).</>}
      </p>
    )}
  </section>
)}

<section>
  <h2>{L('De la instantaneu: performanța radarului', 'Since the snapshot: the radar’s performance')}</h2>
  {afterRows.length ? (
    <p>
      {en ? <>Since {fmtDate(BASELINE)}, the median change of the assets on the radar is {pct(median(afterRows.map((r) => r.after!)))}, against {pct(v.benchAfter)} for {benchName}. By zone:{' '}</>
        : <>De la {fmtDate(BASELINE)}, variația mediană a activelor de pe radar este {pct(median(afterRows.map((r) => r.after!)))}, față de {pct(v.benchAfter)} pentru {benchName}. Pe zone:{' '}</>}
      {v.byZone.map((z) => {
        const xs = afterRows.filter((r) => r.zone === z.z).map((r) => r.after!);
        return xs.length ? <> {ZL[z.z]}: {pct(median(xs))} ({xs.length} {L('active', 'assets')});</> : null;
      })}
    </p>
  ) : (
    <p class="notice">
      {L(`Prima măsurare se face automat vineri, ${fmtDate(firstMeasure)}, față de închiderea din ${fmtDate(BASELINE)}. De atunci, tabelul de mai sus și acest paragraf se actualizează săptămânal, cu toate activele, inclusiv cele care au scăzut.`,
        `The first measurement runs automatically on Friday, ${fmtDate(firstMeasure)}, against the close of ${fmtDate(BASELINE)}. From then on, the table above and this paragraph update weekly, with all assets, including those that fell.`)}
    </p>
  )}
  <p class="muted">{L('Performanța trecută nu este un indicator de încredere pentru rezultatele viitoare. Prețuri înainte de comisioane și taxe. Nu este o recomandare de investiții.', 'Past performance is not a reliable indicator of future results. Prices before fees and taxes. This is not investment advice.')}</p>
</section>
