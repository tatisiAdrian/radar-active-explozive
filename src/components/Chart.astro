---
import type { Dataset } from '../data/types';
import type { Lang } from '../data/i18n';
interface Props { dataset: Dataset; height?: number; lang?: Lang }
const { dataset, height, lang = 'ro' } = Astro.props;
const en = lang === 'en';
---
<figure>
  <div class="chart" style={height ? `height:${height}px` : undefined} data-dataset={JSON.stringify(dataset)} data-locale={en ? 'en-GB' : 'ro-RO'} role="img" aria-label={dataset.title}></div>
  <figcaption class="muted">
    {dataset.title} ({dataset.unit}). {en ? 'Source' : 'Sursa'}: <a href={dataset.source.url} target="_blank" rel="noopener">{dataset.source.name}</a>, {en ? 'retrieved on' : 'preluat la'} {dataset.source.retrievedAt}.
    {dataset.notes && <> {dataset.notes}</>}
  </figcaption>
</figure>

<script>
  // ECharts se încarcă doar când un grafic intră în ecran (lazy-load), iar
  // modulele sunt importate selectiv ca pachetul JS să rămână mic.
  type Pt = [string, number];
  type S = { name: string; points: Pt[] };
  const charts = document.querySelectorAll<HTMLElement>('.chart[data-dataset]');
  const observer = new IntersectionObserver(async (entries) => {
    const visible = entries.filter((e) => e.isIntersecting);
    if (!visible.length) return;
    const echarts = await import('echarts/core');
    const { LineChart, BarChart } = await import('echarts/charts');
    const { GridComponent, TooltipComponent, LegendComponent, DataZoomComponent, MarkLineComponent } = await import('echarts/components');
    const { CanvasRenderer } = await import('echarts/renderers');
    echarts.use([LineChart, BarChart, GridComponent, TooltipComponent, LegendComponent, DataZoomComponent, MarkLineComponent, CanvasRenderer]);
    const dark = matchMedia('(prefers-color-scheme: dark)').matches;
    for (const { target } of visible) {
      observer.unobserve(target);
      const el = target as HTMLElement;
      const ds = JSON.parse(el.dataset.dataset!) as { unit: string; chart: 'line' | 'bar'; series: S[] };
      // Axa X = toate etichetele din toate seriile, în ordinea apariției; valorile lipsă rămân goale.
      const x: string[] = [];
      for (const s of ds.series) for (const [k] of s.points) if (!x.includes(k)) x.push(k);
      if (ds.series.every((s) => s.points.every(([k]) => /^\d{4}-\d{2}-\d{2}$/.test(k)))) x.sort();
      const long = x.length > 12 && ds.chart === 'line';
      const rotate = ds.chart === 'bar' && x.length > 6;
      const many = ds.series.length > 6;
      const chart = echarts.init(el, dark ? 'dark' : undefined, { renderer: 'canvas' });
      const fmt = (v: unknown) => (typeof v === 'number' ? v.toLocaleString(el.dataset.locale ?? 'ro-RO', { maximumFractionDigits: 2 }) : '—');
      chart.setOption({
        backgroundColor: 'transparent',
        tooltip: { trigger: 'axis', valueFormatter: fmt, confine: true },
        legend: { top: 0, type: many ? 'scroll' : 'plain' },
        grid: { left: 60, right: 20, top: 44, bottom: long ? 80 : rotate ? 90 : 40 },
        dataZoom: long ? [{ type: 'inside' }, { type: 'slider', bottom: 10 }] : [],
        xAxis: { type: 'category', data: x, axisLabel: rotate ? { interval: 0, rotate: 40 } : {} },
        yAxis: { type: 'value', name: ds.unit, scale: ds.chart === 'line' },
        series: ds.series.map((s) => {
          const m = new Map(s.points);
          return {
            name: s.name,
            type: ds.chart,
            smooth: ds.chart === 'line',
            connectNulls: true,
            symbolSize: 5,
            emphasis: { focus: 'series' },
            data: x.map((k) => m.get(k) ?? null),
          };
        }),
      });
      new ResizeObserver(() => chart.resize()).observe(el);
    }
  }, { rootMargin: '200px' });
  charts.forEach((c) => observer.observe(c));
</script>
