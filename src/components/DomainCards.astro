---
import { overviewFor } from '../data/overview';
import { domains } from '../data/domains';
import { photoForDomain } from '../data/photos';
import { fondTag } from '../data/explain';
import { type Lang, DOMAIN_EN, PHOTO_ALT_EN } from '../data/i18n';

interface Props { lang?: Lang; only: string[] }
const { lang = 'ro', only } = Astro.props;
const en = lang === 'en';
const base = import.meta.env.BASE_URL;
const T = en
  ? { assets: 'assets', with: 'with 10+', watch: 'on watch', fff: 'substance without form', fffTip: 'Solid substance, not yet inflated by price, press or crowding', cta: 'Open the analysis (RO) →' }
  : { assets: 'active', with: 'cu 10+', watch: 'în observație', fff: 'fond fără formă', fffTip: 'Fond solid, încă neumflat de preț, presă sau aglomerație', cta: 'Deschide analiza →' };
const cards = overviewFor(lang, only).map((d) => ({
  d,
  strong: d.items.filter((x) => x.met >= 10).length,
  watch: d.items.filter((x) => x.met >= 6 && x.met < 10).length,
  top: [...d.items].sort((a, b) => b.met - a.met || b.score - a.score).slice(0, 3),
  summary: en ? DOMAIN_EN[d.slug]?.summary ?? '' : domains.find((x) => x.slug === d.slug)?.summary ?? '',
  ph: photoForDomain(d.slug),
  fff: d.items.filter((x) => fondTag(x.c) === 'fond-fara-forma').length,
}));
---
<div class="dgrid">
  {cards.map((c) => (
    <a class="dcard" href={`${base}domenii/${c.d.slug}/`} hreflang={en ? 'ro' : undefined} style={`--c:${c.d.color}`}>
      {c.ph ? <img class="dimg" src={`${base}images/${c.ph.key}-800.jpg`} alt={en ? PHOTO_ALT_EN[c.ph.key] ?? c.ph.alt : c.ph.alt} loading="lazy" decoding="async" width="800" height="533" style={c.ph.key === 'romania' ? 'object-position:center 35%' : undefined} /> : <span class="dbar"></span>}
      <h3>{c.d.title}</h3>
      <p class="muted">{c.summary}</p>
      <div class="dstats">
        <span><b>{c.d.items.length}</b> {T.assets}</span>
        <span class="strong"><b>{c.strong}</b> {T.with}</span>
        <span class="watch"><b>{c.watch}</b> {T.watch}</span>
        <span class="fff" title={T.fffTip}><b>{c.fff}</b> {T.fff}</span>
      </div>
      <ol class="dtop">
        {c.top.map((t) => <li><span>{t.name}</span><b>{t.met}/14</b></li>)}
      </ol>
      <span class="dcta">{T.cta}</span>
    </a>
  ))}
</div>
