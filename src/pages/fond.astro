---
import Base from '../layouts/Base.astro';
import PhotoHeader from '../components/PhotoHeader.astro';
import { photo } from '../data/photos';
import { OVERVIEW } from '../data/overview';
import { fondTag, FOND_LABEL, FOND_HINT, type FondTag } from '../data/explain';

const base = import.meta.env.BASE_URL;
const ph = photo('fond')!;
const all = OVERVIEW.flatMap((d) => d.items.map((it) => ({ ...it, domain: d.short, slug: d.slug, tag: fondTag(it.c) })));
const ORDER: FondTag[] = ['fond-fara-forma', 'fond-confirmat', 'in-confirmare', 'forma-fara-fond'];
const groups = ORDER.map((t) => {
  const items = all.filter((x) => x.tag === t).sort((a, b) => b.met - a.met || b.score - a.score);
  return { t, n: items.length, examples: items.slice(0, 6) };
});
---
<Base title="De ce căutăm fondul, nu forma" description="Fundamentul metodei: în spatele fiecărei forme (listare, evaluare, atenție) căutăm fondul care o susține (utilizare, clienți, finanțe, instituții)." image="images/fond-1600.jpg">
  <PhotoHeader photo={ph} title="De ce căutăm fondul, nu forma" eyebrow="Fundamentul metodei" summary="În spatele oricărei forme strălucitoare (o listare la bursă, o evaluare de miliarde, un val de articole) ne întrebăm un singur lucru: există fond care s-o susțină?" position="center 30%" />

  <section>
    <h2>O idee veche de peste 150 de ani</h2>
    <p>
      În a doua jumătate a secolului al XIX-lea, România importa în ritm rapid instituțiile Occidentului: academie, universitate, constituție, presă, societăți științifice. În 1868, criticul Titu Maiorescu, din cercul Junimea de la Iași, a observat că multe dintre ele erau <b>forme fără fond</b>: aveau numele și clădirea, dar nu și oamenii, cultura și economia care să le umple de conținut.
      Concluzia lui era că o formă fără fond nu e doar inutilă, ci dăunătoare, pentru că discreditează instituția și strică încrederea în ea.
    </p>
    <p>
      Mai târziu, Eugen Lovinescu a adus nuanța: uneori forma vine prima și își creează fondul în timp. O universitate aproape goală poate forma, în câteva generații, oamenii care o umplu. Ambele idei ne ajută în piețe.
    </p>
  </section>

  <section>
    <h2>Forma și fondul în piețe</h2>
    <p>Forma e ce se vede de departe. Fondul e ce o susține. Radarul dă ponderea cea mai mare fondului și tratează semnalele de formă cu prudență:</p>
    <div class="table-wrap">
      <table class="radar">
        <thead><tr><th>Forma (ce se vede)</th><th>Fondul (ce o susține)</th><th>Unde e în radar</th></tr></thead>
        <tbody>
          <tr><td>Un token lansat, o listare la bursă, o rundă de finanțare</td><td>Utilizatori și venituri reale</td><td>„Folosit cu adevărat”, cea mai mare pondere (16%)</td></tr>
          <tr><td>O evaluare de miliarde, eticheta „AI”</td><td>Bani generați, marje, cost de producție</td><td>Ofertă, flux de numerar, preț de intrare</td></tr>
          <tr><td>Activitate mare pe o platformă</td><td>Clienți care plătesc, nu atrași doar de recompense</td><td>„Clienți reali”</td></tr>
          <tr><td>O dobândă mare la o monedă</td><td>Instituții credibile, export, inflație sub control</td><td>Fluxuri reale, instituții, la Forex</td></tr>
          <tr><td>Articole în presă, mulțimea care cumpără</td><td>Nimic: zgomot</td><td>„Media” și „aglomerație”, notate invers</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2>Patru situații, pe toate cele {all.length} de active</h2>
    <p class="muted">Eticheta se calculează automat din note: fondul (utilizare reală, clienți reali, echipă sau instituții, ofertă sau finanțe) față de semnalele de formă umflată (preț scump, euforie în presă, aglomerație). O găsești lângă fiecare activ, pe paginile domeniilor.</p>
    <div class="tags">
      {groups.map((g) => (
        <div class="tagcard">
          <p><span class:list={['fond', g.t]}>{FOND_LABEL[g.t]}</span> <b class="n">{g.n}</b> active</p>
          <p class="muted">{FOND_HINT[g.t]}</p>
          <ul>{g.examples.map((e) => <li><a href={`${base}domenii/${e.slug}/`}>{e.name}</a> <small class="muted">{e.domain} · {e.met}/14</small></li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>Când intrăm: foarte devreme sau foarte târziu</h2>
    <div class="sgrid">
      <div><h3>Foarte târziu</h3><p><b>Forma s-a prăbușit, fondul a rămas.</b> Prețul a scăzut cu 80–90%, dar utilizarea crește. E testul cel mai sever: a supraviețuit doar fondul.</p></div>
      <div><h3>Foarte devreme</h3><p><b>Pariul că forma își va crea fondul.</b> Înainte de lansare, când există deja semne de fond. Riscant, deci doar sume mici.</p></div>
      <div><h3>Niciodată la mijloc</h3><p><b>Forma la apogeu, fondul neconfirmat.</b> Prețul, presa și mulțimea sunt la maxim, iar dovezile lipsesc. Aici se pierd cei mai mulți bani.</p></div>
    </div>
  </section>

  <section>
    <h2>Limitele ideii</h2>
    <p>
      O analogie nu e o dovadă. Chiar Lovinescu a arătat că teoria formelor fără fond are limite: uneori forma chiar creează fondul. De aceea nu ne bazăm pe argument, ci pe măsurare:
      notele sunt înghețate în instantanee publice, iar rezultatul se compară săptămânal cu piața, inclusiv atunci când greșim.
    </p>
    <p><a href={`${base}metodologie/`}>Metodologia completă</a> · <a href={base}>Radarul tuturor domeniilor</a></p>
  </section>
</Base>

<style>
  .tags { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
  .tagcard { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.1rem 1.2rem; }
  .tagcard p { margin: 0 0 .5rem; }
  .tagcard .n { font: 800 1.4rem var(--f-display); margin-left: .35rem; }
  .tagcard ul { margin: .5rem 0 0; padding-left: 1.1rem; }
  .tagcard li { margin: .2rem 0; }
  .sgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .sgrid div { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.2rem; }
  .sgrid h3 { margin: 0 0 .4rem; }
  .sgrid p { margin: 0; color: var(--muted); }
  @media (max-width: 800px) { .sgrid { grid-template-columns: 1fr; } }
</style>
