---
import Base from '../../layouts/Base.astro';
import PhotoHeader from '../../components/PhotoHeader.astro';
import { photo } from '../../data/photos';
import DomainCard from '../../components/DomainCard.astro';
import { topLevel } from '../../data/domains';
import { CAT_LIST, catOf } from '../../data/categories';
const base = import.meta.env.BASE_URL;
const all = topLevel();
const active = all.filter((d) => d.status === 'activ');
const planned = all.filter((d) => d.status === 'planificat');
---
<Base alt="en/domains/" title="Domenii">
<PhotoHeader photo={photo('domenii')!} title="Toate domeniile" eyebrow="Investiții și macroeconomie" summary="Fiecare domeniu are pagina lui: clasamentul complet, nota la fiecare condiție, datele oficiale și sursele." />
  <p class="muted">Fundamentarea radarului: prețuri și statistici preluate direct din surse oficiale (World Bank, CoinGecko și altele), fiecare cu link și dată de preluare. Fiecare domeniu are pagina lui.</p>
  <p><a href={base}>← Prima pagină</a></p>

  {CAT_LIST.map((c) => (
    <section>
      <h2>{c.t.ro.name}</h2>
      <p class="muted">{c.t.ro.question} <a href={`${base}${c.path.ro}`}>{c.t.ro.cta}</a></p>
      <div class="grid">{active.filter((d) => catOf(d.slug).key === c.key).map((d) => <DomainCard domain={d} />)}</div>
    </section>
  ))}

  {planned.length > 0 && <section>
    <h2>În pregătire</h2>
    <div class="grid">{planned.map((d) => <DomainCard domain={d} />)}</div>
  </section>}
</Base>
