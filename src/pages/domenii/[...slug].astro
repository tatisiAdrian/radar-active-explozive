---
import Base from '../../layouts/Base.astro';
import DomainCard from '../../components/DomainCard.astro';
import Chart from '../../components/Chart.astro';
import RadarSection from '../../components/RadarSection.astro';
import ForexSection from '../../components/ForexSection.astro';
import EmergingSection from '../../components/EmergingSection.astro';
import emMacro from '../../data/emerging/macro.json';
import forexMacro from '../../data/forex/macro.json';
import { domains, childrenOf, breadcrumbs } from '../../data/domains';
import { datasets, datasetsFor, datasetById } from '../../data/datasets';
import { dbSource, radarView } from '../../data/radar';
import { CRITERIA, WEIGHTS } from '../../data/criteria';
import type { Domain } from '../../data/types';

export function getStaticPaths() {
  // Build-ul eșuează dacă o interpretare citează un set de date inexistent
  // sau dacă un set de date aparține unui domeniu nedefinit.
  for (const d of domains) {
    for (const i of d.interpretations ?? []) {
      for (const id of i.basedOn) {
        if (!datasetById(id)) throw new Error(`Interpretarea „${i.title}” (${d.slug}) citează setul inexistent „${id}”.`);
      }
    }
  }
  for (const ds of datasets) {
    if (!domains.some((d) => d.slug === ds.domain)) throw new Error(`Setul „${ds.id}” are domeniul inexistent „${ds.domain}”.`);
  }
  return domains.map((domain) => ({ params: { slug: domain.slug }, props: { domain } }));
}

interface Props { domain: Domain }
const { domain } = Astro.props;
const base = import.meta.env.BASE_URL;
const data = datasetsFor(domain.slug);
const subdomains = childrenOf(domain.slug);
const crumbs = breadcrumbs(domain.slug);
const sources = [...new Map(data.map((d) => [d.source.url, d.source])).values()];
const radarRows = domain.radarMarket ? radarView(domain.radarMarket, domain.countries).rows.length : 0;
if (radarRows) sources.push(dbSource);
if (domain.slug === 'forex') sources.push(forexMacro.sources.imf, forexMacro.sources.bis, forexMacro.sources.fx);
if (domain.slug === 'economii-emergente') sources.push(emMacro.sources.imf, emMacro.sources.bis, emMacro.sources.fx);
const scored = ['forex', 'economii-emergente'].includes(domain.slug);
const criteria = domain.criteria ? CRITERIA[domain.criteria] : undefined;
if (domain.criteria && !criteria) throw new Error(`Setul de condiții „${domain.criteria}” nu există (${domain.slug}).`);
---
<Base title={domain.title} description={domain.summary}>
  <p class="crumbs">
    <a href={`${base}domenii/`}>Date oficiale</a>
    {crumbs.map((c) => <> / <a href={`${base}domenii/${c.slug}/`}>{c.title}</a></>)}
  </p>
  <span class:list={['badge', domain.status]}>{domain.status === 'activ' ? 'Activ' : 'Planificat'}</span>
  <h1>{domain.title}</h1>
  <p>{domain.summary}</p>

  <section>
    <h2>Întrebări la care răspunde analiza</h2>
    <ul>{domain.questions.map((q) => <li>{q}</li>)}</ul>
  </section>

  {domain.slug === 'forex' && <ForexSection />}
  {domain.slug === 'economii-emergente' && <EmergingSection />}
  {domain.radarMarket && radarRows > 0 && <RadarSection market={domain.radarMarket} domain={domain.slug} countries={domain.countries} />}
  {domain.radarMarket && radarRows === 0 && (
    <section>
      <h2>Activele de pe radar în această zonă</h2>
      <p class="notice">Niciun activ din această zonă nu e încă pe radar. Le adăugăm doar după ce le notăm pe aceleași 14 condiții, cu date verificabile. Până atunci nu afișăm clasamente sau cifre.</p>
    </section>
  )}

  {criteria && (
    <section>
      <h2>Cum aplicăm cele 14 condiții {domain.radarMarket ? 'aici' : 'în acest domeniu'}</h2>
      <p class="muted">Același algoritm ca la cripto, companii și mărfuri: fiecare condiție primește o notă de la 0 la 10 și e îndeplinită de la 7. Ponderile sunt identice în toate domeniile; se schimbă doar ce măsurăm concret.{!domain.radarMarket && !scored && ' Primele active din acest domeniu vor fi notate și publicate cu instantaneu înghețat, ca restul radarului.'}</p>
      <div class="table-wrap">
        <table class="radar criteria">
          <thead><tr><th>#</th><th>Condiție</th><th>Ce măsurăm</th><th>Pondere</th></tr></thead>
          <tbody>
            {criteria.map(([name, what], i) => (
              <tr><td class="muted">C{i + 1}</td><td><b>{name}</b></td><td>{what}</td><td class="num">{WEIGHTS[i]}%</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {!scored && <section>
    <h2>{domain.radarMarket ? 'Fundamentare: date oficiale' : 'Date și grafice'}</h2>
    {data.length
      ? data.map((ds) => <Chart dataset={ds} />)
      : <p class="notice">Datele sunt în curs de colectare din surse oficiale. Nu afișăm nicio cifră până nu are sursă verificabilă.</p>}
  </section>}

  {domain.interpretations?.length ? (
    <section>
      <h2>Interpretare</h2>
      {domain.interpretations.map((i) => (
        <article>
          <h3>{i.title}</h3>
          <p>{i.text}</p>
          <p class="muted">Bazat pe: {i.basedOn.map((id) => datasetById(id)?.title ?? id).join('; ')}</p>
        </article>
      ))}
    </section>
  ) : null}

  {subdomains.length > 0 && (
    <section>
      <h2>Analize detaliate</h2>
      <div class="grid">{subdomains.map((d) => <DomainCard domain={d} />)}</div>
    </section>
  )}

  <section>
    <h2>Surse</h2>
    {sources.length
      ? <ul>{sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.name}</a> (preluat la {s.retrievedAt})</li>)}</ul>
      : <p class="muted">Sursele vor fi listate aici odată cu datele.</p>}
    <p><a href={`${base}metodologie/`}>Cum verificăm datele →</a></p>
  </section>
</Base>
